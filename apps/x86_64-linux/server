#!/usr/bin/env bash
set -euo pipefail

# Thin shim: delegate entirely to the server branch
# flake app so all installer logic and configs come
# from the server branch, not testing.
exec nix run --no-write-lock-file \
  --extra-experimental-features 'nix-command flakes' \
  github:xlrinn/nix/server#server -- "$@"
